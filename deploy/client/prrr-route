#!/bin/bash
# prrr-route: Set up / tear down VPN routing and DNS
# Usage: prrr-route up|down
#
# Called by the prrr binary after transport connects (up) and before
# disconnect/reconnect (down). All parameters are sourced from
# /run/prrr/env, written by the binary.
#
# Uses fwmark-based policy routing (WireGuard-style):
#   - VPN transport sockets are marked with SO_MARK by the binary
#   - ip rule routes unmarked traffic through the VPN tunnel
#   - Marked packets (VPN protocol traffic) bypass the tunnel via main table
#
# This eliminates pinned host routes and works with DNS round-robin,
# reconnection to different IPs, and multi-VPN setups.

set -euo pipefail

# PRRR_ENV_FILE lets black-box tests point the hook at a fixture env file.
ENV_FILE="${PRRR_ENV_FILE:-/run/prrr/env}"

# Source structured env from binary
load_env() {
    if [[ -f "$ENV_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$ENV_FILE"
    else
        echo "Error: env file not found: $ENV_FILE" >&2
        echo "prrr-route should be called by the prrr binary, not manually." >&2
        exit 1
    fi
}

# Wait for the TUN device to appear (safety check)
wait_for_tun() {
    local tries=0
    while ! ip link show "$PRRR_DEVICE" &>/dev/null; do
        sleep 0.2
        tries=$((tries + 1))
        if [[ $tries -ge 50 ]]; then
            echo "Error: TUN device $PRRR_DEVICE did not appear within 10s" >&2
            exit 1
        fi
    done
}

do_up() {
    load_env

    local fwmark="${PRRR_FWMARK:-51820}"
    local route_table="$fwmark"

    wait_for_tun

    # Routes pointing at a DOWN device are inert; an interrupted restart can
    # leave the TUN administratively down. Idempotent bring-up.
    ip link set "$PRRR_DEVICE" up

    if [[ "${PRRR_ALL_TRAFFIC}" == "true" ]]; then
        echo "Setting up full-tunnel routing (fwmark=$fwmark)..."

        # fwmark policy routing (WireGuard-style):
        # 1. Default route through TUN in a separate table
        ip -4 route add default dev "$PRRR_DEVICE" table "$route_table" 2>/dev/null || true

    else
        echo "Setting up split-tunnel routing..."
        # Only the VPN subnet is routed through the tunnel (default from TUN setup)
    fi

    install_resource_routes

    if [[ "${PRRR_ALL_TRAFFIC}" == "true" || -n "${PRRR_RESOURCE_IPS:-}" ]]; then
        # Unmarked packets use the VPN table; marked packets (SO_MARK) skip it.
        ip -4 rule add not fwmark "$fwmark" table "$route_table" priority 32765 2>/dev/null || true

        # Suppress the host default route so resource routes win while other
        # split-tunnel traffic still falls through to the host's main table.
        ip -4 rule add table main suppress_prefixlength 0 priority 32764 2>/dev/null || true
    fi

    # Set up DNS
    setup_dns

    echo "prrr VPN routing is UP"
}

do_down() {
    # Source env if available (may not exist on abnormal exit)
    if [[ -f "$ENV_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$ENV_FILE"
    fi

    local fwmark="${PRRR_FWMARK:-51820}"
    local route_table="$fwmark"
    local device="${PRRR_DEVICE:-prrr0}"

    echo "Tearing down prrr VPN routing..."

    # Remove fwmark rules and routes
    ip -4 rule del not fwmark "$fwmark" table "$route_table" 2>/dev/null || true
    ip -4 rule del table main suppress_prefixlength 0 2>/dev/null || true
    ip -4 route del default dev "$device" table "$route_table" 2>/dev/null || true
    remove_resource_routes

    # Reset DNS
    teardown_dns

    echo "prrr VPN routing is DOWN"
}

install_resource_routes() {
    local resource_ip
    # PRRR_RESOURCE_IPS is a space-separated list written by the binary;
    # `read <<< "$var"` would consume it as ONE line (unquoted expansion
    # splits on IFS words here instead).
    # shellcheck disable=SC2086
    for resource_ip in ${PRRR_RESOURCE_IPS:-}; do
        ip -4 route replace "${resource_ip}/32" dev "$PRRR_DEVICE" table "${PRRR_FWMARK:-51820}"
    done
}

remove_resource_routes() {
    local resource_ip
    # shellcheck disable=SC2086
    for resource_ip in ${PRRR_RESOURCE_IPS:-}; do
        ip -4 route del "${resource_ip}/32" dev "${PRRR_DEVICE:-prrr0}" table "${PRRR_FWMARK:-51820}" 2>/dev/null || true
    done
}

setup_dns() {
    local dns_servers="${PRRR_DNS_SERVERS:-}"
    if [[ -z "$dns_servers" ]]; then
        return
    fi

    if command -v resolvectl &>/dev/null; then
        # systemd-resolved (Fedora, Ubuntu 18.04+)
        # shellcheck disable=SC2086
        resolvectl dns "$PRRR_DEVICE" $dns_servers 2>/dev/null || true
        resolvectl domain "$PRRR_DEVICE" "~." 2>/dev/null || true
        echo "DNS set via resolvectl: $dns_servers"
    elif command -v resolvconf &>/dev/null; then
        # openresolv (Debian, Arch, Alpine)
        # shellcheck disable=SC2086
        printf 'nameserver %s\n' $dns_servers | resolvconf -a "$PRRR_DEVICE" 2>/dev/null || true
        echo "DNS set via resolvconf: $dns_servers"
    else
        # Direct /etc/resolv.conf manipulation (last resort)
        if [[ ! -f /etc/resolv.conf.prrr-backup ]]; then
            cp /etc/resolv.conf /etc/resolv.conf.prrr-backup 2>/dev/null || true
        fi
        # shellcheck disable=SC2086
        printf 'nameserver %s\n' $dns_servers > /etc/resolv.conf
        echo "DNS set via /etc/resolv.conf: $dns_servers"
    fi
}

teardown_dns() {
    local device="${PRRR_DEVICE:-prrr0}"

    if command -v resolvectl &>/dev/null; then
        resolvectl revert "$device" 2>/dev/null || true
    elif command -v resolvconf &>/dev/null; then
        resolvconf -d "$device" 2>/dev/null || true
    else
        # Restore backed-up resolv.conf
        if [[ -f /etc/resolv.conf.prrr-backup ]]; then
            mv /etc/resolv.conf.prrr-backup /etc/resolv.conf
        fi
    fi
}

case "${1:-}" in
    up)   do_up ;;
    down) do_down ;;
    *)
        echo "Usage: prrr-route up|down" >&2
        exit 1
        ;;
esac
