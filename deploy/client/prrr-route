#!/bin/bash
# prrr-route: Set up / tear down VPN routing and DNS
# Usage: prrr-route up|down
#
# Called by the prrr binary after transport connects (up) and before
# disconnect/reconnect (down). All parameters are sourced from
# /run/prrr/env, written by the binary.
#
# Uses fwmark-based policy routing (WireGuard-style):
#   - VPN transport sockets are marked with SO_MARK by the binary
#   - ip rule routes unmarked traffic through the VPN tunnel
#   - Marked packets (VPN protocol traffic) bypass the tunnel via main table
#
# This eliminates pinned host routes and works with DNS round-robin,
# reconnection to different IPs, and multi-VPN setups.

set -euo pipefail

# PRRR_ENV_FILE lets black-box tests point the hook at a fixture env file.
ENV_FILE="${PRRR_ENV_FILE:-/run/prrr/env}"

# Source structured env from binary
load_env() {
    if [[ -f "$ENV_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$ENV_FILE"
    else
        echo "Error: env file not found: $ENV_FILE" >&2
        echo "prrr-route should be called by the prrr binary, not manually." >&2
        exit 1
    fi
}

# Wait for the TUN device to appear (safety check)
wait_for_tun() {
    local tries=0
    while ! ip link show "$PRRR_DEVICE" &>/dev/null; do
        sleep 0.2
        tries=$((tries + 1))
        if [[ $tries -ge 50 ]]; then
            echo "Error: TUN device $PRRR_DEVICE did not appear within 10s" >&2
            exit 1
        fi
    done
}

# Keep NetworkManager away from the tunnel device.
#
# NM adopts foreign TUN devices and auto-activates a profile for them; a later
# deactivation flushes the tunnel address while the client still owns the
# device fd. Packets then leave the TUN sourced with a LAN address, the server
# stops masquerading them (its rule is scoped to the tunnel subnet) and no
# reply ever comes back — a one-way black hole with routing reported UP.
# See specs/bugs/BUG-network-manager-tun-address-loss.md. Scoped to this one
# device, so other tunnels (e.g. tun0) are untouched.
detach_from_network_manager() {
    command -v nmcli &>/dev/null || return 0
    nmcli device set "$PRRR_DEVICE" managed no 2>/dev/null ||
        echo "Warning: NetworkManager still manages $PRRR_DEVICE" >&2
}

# Re-assert the tunnel IPv4 address on every "up".
#
# The kernel sources injected packets with this address, so if anything (NM, an
# operator, a device re-register) removed it the tunnel stops working entirely.
# Re-running on each refresh cycle makes external address loss self-heal within
# one cycle instead of persisting until the next restart.
ensure_tunnel_address() {
    local addr="$PRRR_CLIENT_IP"
    if ip -4 addr show dev "$PRRR_DEVICE" 2>/dev/null | grep -qE "inet ${addr}(/| )"; then
        return 0
    fi
    if ip -4 addr add "${addr}/32" dev "$PRRR_DEVICE" 2>/dev/null; then
        echo "Re-asserted tunnel address ${addr}/32 on ${PRRR_DEVICE}"
    else
        echo "Error: ${addr}/32 missing from ${PRRR_DEVICE} and could not be added" >&2
        return 1
    fi
}

do_up() {
    load_env

    local fwmark="${PRRR_FWMARK:-51820}"
    local route_table="$fwmark"

    wait_for_tun

    # Routes pointing at a DOWN device are inert; an interrupted restart can
    # leave the TUN administratively down. Idempotent bring-up.
    ip link set "$PRRR_DEVICE" up

    # Address ownership must be ours before any route points at the device.
    detach_from_network_manager
    ensure_tunnel_address

    if [[ "${PRRR_ALL_TRAFFIC}" == "true" ]]; then
        echo "Setting up full-tunnel routing (fwmark=$fwmark)..."

        # fwmark policy routing (WireGuard-style):
        # 1. Default route through TUN in a separate table
        ip -4 route add default dev "$PRRR_DEVICE" table "$route_table" 2>/dev/null || true

    else
        echo "Setting up split-tunnel routing..."
        # Only the VPN subnet is routed through the tunnel (default from TUN setup)
    fi

    remove_stale_resource_routes
    install_resource_routes

    if [[ "${PRRR_ALL_TRAFFIC}" == "true" || -n "${PRRR_RESOURCE_IPS:-}" ]]; then
        # Unmarked packets use the VPN table; marked packets (SO_MARK) skip it.
        ip -4 rule add not fwmark "$fwmark" table "$route_table" priority 32765 2>/dev/null || true

        # Suppress the host default route so resource routes win while other
        # split-tunnel traffic still falls through to the host's main table.
        ip -4 rule add table main suppress_prefixlength 0 priority 32764 2>/dev/null || true

        # Advertise tunnel DNS only along with a live path through the tunnel.
        apply_dns_policy
    else
        # Nothing reaches the tunnel in this mode, so advertising its DNS
        # servers would point every system query at a device with no route.
        echo "No tunnel traffic configured; host resolver left unchanged"
    fi

    echo "prrr VPN routing is UP"
}

do_down() {
    # Source env if available (may not exist on abnormal exit)
    if [[ -f "$ENV_FILE" ]]; then
        # shellcheck disable=SC1090
        source "$ENV_FILE"
    fi

    local fwmark="${PRRR_FWMARK:-51820}"
    local route_table="$fwmark"
    local device="${PRRR_DEVICE:-prrr0}"

    echo "Tearing down prrr VPN routing..."

    # Remove fwmark rules and routes
    ip -4 rule del not fwmark "$fwmark" table "$route_table" 2>/dev/null || true
    ip -4 rule del table main suppress_prefixlength 0 2>/dev/null || true
    ip -4 route del default dev "$device" table "$route_table" 2>/dev/null || true
    remove_resource_routes
    remove_dns_routes

    # Reset DNS
    teardown_dns

    echo "prrr VPN routing is DOWN"
}

install_resource_routes() {
    local resource_ip
    # PRRR_RESOURCE_IPS is a space-separated list written by the binary;
    # `read <<< "$var"` would consume it as ONE line (unquoted expansion
    # splits on IFS words here instead).
    # shellcheck disable=SC2086
    for resource_ip in ${PRRR_RESOURCE_IPS:-}; do
        ip -4 route replace "${resource_ip}/32" dev "$PRRR_DEVICE" table "${PRRR_FWMARK:-51820}"
    done
}

install_dns_routes() {
    # IPv4 DNS servers as exact /32s into the policy table. IPv6 servers are
    # skipped: the client TUN is IPv4-only (same scope as resource routes).
    local dns_ip
    # shellcheck disable=SC2086
    for dns_ip in ${PRRR_DNS_SERVERS:-}; do
        if [[ "$dns_ip" != *:* ]]; then
            ip -4 route replace "${dns_ip}/32" dev "$PRRR_DEVICE" table "${PRRR_FWMARK:-51820}"
        fi
    done
}

# Apply the DNS policy for this round: hand the tunnel's DNS servers to the
# system resolver, or leave the host's own resolvers in charge if the binary's
# probe found the tunnel resolver unresponsive.
#
# The /32 pins make the configured servers reachable THROUGH the tunnel (without
# them answers come from the host's egress and rotating CDN answers never match
# the pinned resource /32s — BUG-resource-ip-staleness). They are installed in
# both gate states on purpose: they define the path the probe measures, so
# withdrawing them would let the probe answer from the host's egress and the
# gate would oscillate. What the closed gate withholds is the *advertisement* —
# advertising a dead resolver would leave every lookup on the host hanging,
# which is strictly worse than an uncensored-but-working one.
# BUG: specs/bugs/BUG-network-manager-tun-address-loss.md
apply_dns_policy() {
    install_dns_routes
    if [[ "${PRRR_DNS_GATE:-on}" == "off" ]]; then
        if [[ -n "${PRRR_DNS_SERVERS:-}" ]]; then
            echo "DNS gate closed: tunnel resolver unresponsive, host resolver left in charge"
        fi
        teardown_dns
    else
        setup_dns
    fi
}

remove_dns_routes() {
    local dns_ip
    # shellcheck disable=SC2086
    for dns_ip in ${PRRR_DNS_SERVERS:-}; do
        if [[ "$dns_ip" != *:* ]]; then
            ip -4 route del "${dns_ip}/32" dev "${PRRR_DEVICE:-prrr0}" table "${PRRR_FWMARK:-51820}" 2>/dev/null || true
        fi
    done
}

remove_stale_resource_routes() {
    # Resource IPs that left the retention window (written by the binary on
    # refresh). Removed before the fresh set is installed so a rotated-out
    # address never lingers in the policy table.
    local stale_ip
    # shellcheck disable=SC2086
    for stale_ip in ${PRRR_STALE_RESOURCE_IPS:-}; do
        ip -4 route del "${stale_ip}/32" dev "$PRRR_DEVICE" table "${PRRR_FWMARK:-51820}" 2>/dev/null || true
    done
}

remove_resource_routes() {
    local resource_ip
    # shellcheck disable=SC2086
    for resource_ip in ${PRRR_RESOURCE_IPS:-}; do
        ip -4 route del "${resource_ip}/32" dev "${PRRR_DEVICE:-prrr0}" table "${PRRR_FWMARK:-51820}" 2>/dev/null || true
    done
}

setup_dns() {
    # The binary probes every pinned resolver and publishes the ones that
    # actually answered; handing the system resolver an address that never
    # replies costs the whole host a lookup timeout. Older binaries do not
    # publish the verdict, so fall back to the whole configured list.
    # BUG: specs/bugs/BUG-tunnel-dns-single-probe-target.md
    local dns_servers="${PRRR_DNS_ADVERTISE_SERVERS:-${PRRR_DNS_SERVERS:-}}"
    if [[ -z "$dns_servers" ]]; then
        return
    fi

    # Scope the tunnel resolver to the names the tunnel actually carries.
    # In split mode every other name leaves over the host's own path anyway, so
    # owning their resolution only risks it when the tunnel path dips; a full
    # tunnel really does carry everything and must own the whole view. An older
    # binary publishes no resource names, and the catch-all keeps that case
    # exactly as it was.
    # BUG: specs/bugs/BUG-split-mode-dns-catchall-hijacks-host-resolver.md
    local domains="~."
    if [[ "${PRRR_ALL_TRAFFIC:-false}" != "true" && -n "${PRRR_RESOURCE_DOMAINS:-}" ]]; then
        # shellcheck disable=SC2086
        domains=$(printf '~%s ' ${PRRR_RESOURCE_DOMAINS})
    fi

    if command -v resolvectl &>/dev/null; then
        # systemd-resolved (Fedora, Ubuntu 18.04+)
        # shellcheck disable=SC2086
        resolvectl dns "$PRRR_DEVICE" $dns_servers 2>/dev/null || true
        # shellcheck disable=SC2086
        resolvectl domain "$PRRR_DEVICE" $domains 2>/dev/null || true
        echo "DNS set via resolvectl: $dns_servers (domains: $domains)"
    elif command -v resolvconf &>/dev/null; then
        # openresolv (Debian, Arch, Alpine)
        # shellcheck disable=SC2086
        printf 'nameserver %s\n' $dns_servers | resolvconf -a "$PRRR_DEVICE" 2>/dev/null || true
        echo "DNS set via resolvconf: $dns_servers"
    else
        # Direct /etc/resolv.conf manipulation (last resort)
        if [[ ! -f /etc/resolv.conf.prrr-backup ]]; then
            cp /etc/resolv.conf /etc/resolv.conf.prrr-backup 2>/dev/null || true
        fi
        # shellcheck disable=SC2086
        printf 'nameserver %s\n' $dns_servers > /etc/resolv.conf
        echo "DNS set via /etc/resolv.conf: $dns_servers"
    fi
}

teardown_dns() {
    local device="${PRRR_DEVICE:-prrr0}"

    if command -v resolvectl &>/dev/null; then
        resolvectl revert "$device" 2>/dev/null || true
    elif command -v resolvconf &>/dev/null; then
        resolvconf -d "$device" 2>/dev/null || true
    else
        # Restore backed-up resolv.conf
        if [[ -f /etc/resolv.conf.prrr-backup ]]; then
            mv /etc/resolv.conf.prrr-backup /etc/resolv.conf
        fi
    fi
}

case "${1:-}" in
    up)   do_up ;;
    down) do_down ;;
    *)
        echo "Usage: prrr-route up|down" >&2
        exit 1
        ;;
esac
