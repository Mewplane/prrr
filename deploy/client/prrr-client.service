[Unit]
Description=prrr VPN Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/prrr client --config /etc/prrr/client.toml
Restart=on-failure
RestartSec=10
LimitNOFILE=65535

# Needs root for TUN device creation and SO_MARK (fwmark policy routing)
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
