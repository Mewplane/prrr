<?xml version="1.0" encoding="utf-8"?>
<!-- FRD: specs/frds/FRD-M008-android-project-setup.md -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ecosystem coordination: signature-protected so only co-signed sibling
         apps (sy / cathouse) may read/observe the sharing toggle (SPEC §3/§9.3,
         FRD-004). -->
    <permission
        android:name="com.prrr.vpn.android.permission.ECOSYSTEM_COORDINATE"
        android:protectionLevel="signature" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrrrVPN"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PrrrVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for config import (FRD: specs/frds/FRD-M015-deep-link-config-import.md) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="prrr" android:host="import" />
                <data android:scheme="prrr" android:host="connect" />
            </intent-filter>
        </activity>

        <!-- VPN Service (placeholder for Feature 3.4) -->
        <service
            android:name=".vpn.PrrrVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Sharing-toggle coordination surface (SPEC §3/§9.3, FRD-004).
             Signature-protected: only co-signed ecosystem apps may read/observe
             the sharing state. Thin wrapper over the Rust/UniFFI seam, which
             holds the real state + enforcement. -->
        <provider
            android:name=".ecosystem.SharingProvider"
            android:authorities="com.prrr.vpn.android.ecosystem.sharing"
            android:exported="true"
            android:readPermission="com.prrr.vpn.android.permission.ECOSYSTEM_COORDINATE"
            android:writePermission="com.prrr.vpn.android.permission.ECOSYSTEM_COORDINATE" />
    </application>
</manifest>
